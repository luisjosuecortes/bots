115: async def _binance_klines(session, interval, limit=None, start_ms=None):
116:     """Velas de Binance normalizadas a [t_ms, open, high, low, close], ascendente."""
117:     url = f"https://api.binance.com/api/v3/klines?symbol=BTCUSDT&interval={interval}"
