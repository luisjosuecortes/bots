119:         url += f"&startTime={int(start_ms)}"
120:     url += f"&limit={int(limit) if limit else 1000}"
121:     async with session.get(url) as resp:
122:         data = await resp.json()
123:     return [[c[0], float(c[1]), float(c[2]), float(c[3]), float(c[4])] for c in data]
