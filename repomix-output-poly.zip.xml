 1: import urllib.request
 2: import json
 3: import time
 4: from datetime import datetime, timezone
 5: from collections import defaultdict
 6: 
 7: print("🚀 Iniciando análisis granular de datos históricos de Binance (1 hora, 30 días)...")
 8: 
 9: symbol = "BTCUSDT"
10: interval = "1m"
11: limit = 1000
12: days = 30
13: end_time = int(datetime.now(timezone.utc).timestamp() * 1000)
14: start_time = end_time - (days * 24 * 60 * 60 * 1000)
15: 
16: all_candles = []
17: current_start = start_time
18: 
19: while current_start < end_time:
20:     url = f"https://api.binance.com/api/v3/klines?symbol={symbol}&interval={interval}&limit={limit}&startTime={current_start}"
21:     try:
22:         with urllib.request.urlopen(url) as response:
23:             data = json.loads(response.read().decode())
24:             if not data:
25:                 break
26:             all_candles.extend(data)
27:             current_start = data[-1][0] + 60000
28:             time.sleep(0.1)
29:     except Exception:
30:         break
31: 
32: print(f"✅ Descarga completada. Total de velas: {len(all_candles)}")
33: 
34: hours_data = {}
35: for candle in all_candles:
36:     open_time_ms = candle[0]
37:     open_price = float(candle[1])
38:     low_price = float(candle[3])
39:     close_price = float(candle[4])
40:     
41:     hour_key = (open_time_ms // (60 * 60 * 1000)) * (60 * 60 * 1000)
42:     
43:     if hour_key not in hours_data:
44:         hours_data[hour_key] = {'open': open_price, 'low': low_price, 'close': close_price}
45:     else:
46:         if low_price < hours_data[hour_key]['low']:
47:             hours_data[hour_key]['low'] = low_price
48:         hours_data[hour_key]['close'] = close_price
49: 
50: buckets = defaultdict(lambda: {'total': 0, 'up_wins': 0})
51: 
52: for hour_key, data in hours_data.items():
53:     open_p = data['open']
54:     low_p = data['low']
55:     close_p = data['close']
56:     
57:     caida = (open_p - low_p) / open_p
58:     caida_pct = caida * 100
59:     
60:     if caida_pct <= 0.1:
61:         bucket = "0.001" # Representa <= 0.1%
62:     elif caida_pct <= 0.2:
63:         bucket = "0.002" # Representa <= 0.2%
64:     else:
65:         bucket = ">0.002"
66:         
67:     buckets[bucket]['total'] += 1
68:     if close_p >= open_p:
69:         buckets[bucket]['up_wins'] += 1
70: 
71: print("\n" + "="*60)
72: print("📊 MAPA DE PROBABILIDADES HISTÓRICAS (1 HORA)")
73: print("="*60)
74: 
75: mapa_para_bot = {}
76: for bucket in ["0.001", "0.002"]:
77:     if bucket in buckets and buckets[bucket]['total'] >= 15:
78:         prob = (buckets[bucket]['up_wins'] / buckets[bucket]['total'])
79:         mapa_para_bot[float(bucket)] = round(prob, 3)
80:         print(f"Caída <= {float(bucket)*100:.1f}%: Muestras={buckets[bucket]['total']}, Prob. UP = {prob*100:.1f}%")
81: 
82: print("\n" + "="*60)
83: print("📋 COPIA ESTE DICCIONARIO EN TU BOT:")
84: print("MAPA_PROBABILIDADES = {")
85: for k, v in sorted(mapa_para_bot.items()):
86:     print(f"    {k}: {v},  # Caída <= {k*100:.1f}% -> {v*100:.1f}% prob. UP")
87: print("}")
88: print("="*60)
