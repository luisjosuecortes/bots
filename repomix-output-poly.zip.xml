 24:         url = f"https://api.binance.com/api/v3/klines?symbol={symbol}&interval={interval}&limit={limit}&startTime={current_start}"
 25:         try:
 26:             with urllib.request.urlopen(url) as response:
 27:                 data = json.loads(response.read().decode())
 28:                 if not data:
 29:                     break
 30:                 all_candles.extend(data)
 31:                 current_start = data[-1][0] + ms
 32:                 time.sleep(0.1)
 33:         except Exception:
 34:             break
 35:     
 36:     return all_candles
 37: 
 38: 
 39: def descargar_velas_coinbase(interval="1m", days=30, product="BTC-USD"):
 40:     """Descarga histórico de Coinbase (par USD, igual que la fuente de resolución de 5m/15m).
 41: 
 42:     Coinbase devuelve [time_s, low, high, open, close, volume] (máx 300, más reciente
 43:     primero). Se normaliza al MISMO formato que Binance: [openTime_ms, open, high, low, close]
 44:     y se ordena ascendente, para que el resto del análisis funcione sin cambios.
 45:     """
 46:     gran = _GRAN_COINBASE.get(interval, 60)
 47:     paso = gran  # segundos por vela
 48:     span = 300 * paso  # segundos por petición (300 velas)
 49:     end = int(datetime.now(timezone.utc).timestamp())
 50:     inicio_global = end - days * 24 * 3600
 51: 
 52:     normalizadas = []
 53:     cur_end = end
 54:     while cur_end > inicio_global:
 55:         cur_start = max(inicio_global, cur_end - span)
 56:         s_iso = datetime.fromtimestamp(cur_start, timezone.utc).isoformat()
 57:         e_iso = datetime.fromtimestamp(cur_end, timezone.utc).isoformat()
 58:         url = (f"https://api.exchange.coinbase.com/products/{product}/candles"
 59:                f"?granularity={gran}&start={s_iso}&end={e_iso}")
 60:         try:
 61:             req = urllib.request.Request(url, headers=_UA)
 62:             with urllib.request.urlopen(req, timeout=20) as response:
 63:                 data = json.loads(response.read().decode())
 64:         except Exception:
 65:             time.sleep(0.4)
 66:             cur_end = cur_start
 67:             continue
 68:         if not data:
 69:             cur_end = cur_start
 70:             continue
 71:         for c in data:  # [time_s, low, high, open, close, volume]
 72:             normalizadas.append([c[0] * 1000, c[3], c[2], c[1], c[4]])
 73:         cur_end = cur_start
 74:         time.sleep(0.25)
 75: 
 76:     normalizadas.sort(key=lambda x: x[0])
 77:     return normalizadas
 78: 
 79: 
 80: def descargar_velas(interval="1m", days=30, source="binance"):
 81:     """Dispatcher de fuente. Devuelve velas normalizadas [openTime_ms, open, high, low, close]."""
 82:     if source == "coinbase":
 83:         return descargar_velas_coinbase(interval=interval, days=days)
 84:     return descargar_velas_binance(interval=interval, days=days)
 85: 
 86: def agrupar_por_ventana(all_candles, interval):
 87:     """Agrupa las velas por su ventana de tiempo correspondiente."""
 88:     if interval == "1m":
 89:         window_ms = 60000
 90:     elif interval == "5m":
 91:         window_ms = 300000
 92:     elif interval == "15m":
 93:         window_ms = 900000
 94:     elif interval == "30m":
 95:         window_ms = 1800000
 96:     elif interval == "1h":
 97:         window_ms = 3600000
 98:     elif interval == "4h":
 99:         window_ms = 14400000
100:     else:
101:         window_ms = 60000
102:     
103:     windows_data = {}
104:     for candle in all_candles:
105:         open_time_ms = candle[0]
106:         open_price = float(candle[1])
107:         low_price = float(candle[3])
108:         close_price = float(candle[4])
109:         
110:         window_key = (open_time_ms // window_ms) * window_ms
111:         
112:         if window_key not in windows_data:
113:             windows_data[window_key] = {'open': open_price, 'low': low_price, 'close': close_price}
114:         else:
115:             if low_price < windows_data[window_key]['low']:
116:                 windows_data[window_key]['low'] = low_price
117:             windows_data[window_key]['close'] = close_price
118:     
119:     return windows_data
120: 
121: def calcular_mapa_probabilidades(windows_data, interval):
122:     """Calcula el mapa de probabilidades basado en los datos históricos agrupados."""
123:     buckets = defaultdict(lambda: {'total': 0, 'up_wins': 0})
124:     
125:     for window_key, data in windows_data.items():
126:         open_p = data['open']
127:         low_p = data['low']
128:         close_p = data['close']
129:         
130:         if open_p == 0:
131:             continue
132:             
133:         caida = (open_p - low_p) / open_p
134:         caida_pct = caida * 100
135:         
136:         # Definir rangos según el intervalo
137:         if interval in ["1m", "5m"]:
138:             # Rangos de 0.05% para intervalos cortos
139:             if caida_pct <= 0.05:
140:                 bucket = 0.0005
141:             elif caida_pct <= 0.10:
142:                 bucket = 0.001
143:             elif caida_pct <= 0.15:
144:                 bucket = 0.0015
145:             elif caida_pct <= 0.20:
146:                 bucket = 0.002
147:             elif caida_pct <= 0.30:
148:                 bucket = 0.003
149:             else:
150:                 bucket = None
151:         elif interval in ["15m", "30m"]:
152:             # Rangos de 0.1% para intervalos medianos
153:             if caida_pct <= 0.1:
154:                 bucket = 0.001
155:             elif caida_pct <= 0.2:
156:                 bucket = 0.002
157:             elif caida_pct <= 0.3:
158:                 bucket = 0.003
159:             elif caida_pct <= 0.5:
160:                 bucket = 0.005
161:             elif caida_pct <= 1.0:
162:                 bucket = 0.01
163:             else:
164:                 bucket = None
165:         elif interval == "1h":
166:             # Rangos de 0.1% para 1 hora
167:             if caida_pct <= 0.1:
168:                 bucket = 0.001
169:             elif caida_pct <= 0.2:
170:                 bucket = 0.002
171:             elif caida_pct <= 0.5:
172:                 bucket = 0.005
173:             elif caida_pct <= 1.0:
174:                 bucket = 0.01
175:             else:
176:                 bucket = None
177:         elif interval == "4h":
178:             # Rangos de 0.2% para 4 horas
179:             if caida_pct <= 0.2:
180:                 bucket = 0.002
181:             elif caida_pct <= 0.5:
182:                 bucket = 0.005
183:             elif caida_pct <= 1.0:
184:                 bucket = 0.01
185:             elif caida_pct <= 2.0:
186:                 bucket = 0.02
187:             else:
188:                 bucket = None
189:         else:
190:             bucket = None
191:         
192:         if bucket is not None:
193:             buckets[bucket]['total'] += 1
194:             if close_p >= open_p:
195:                 buckets[bucket]['up_wins'] += 1
196:     
197:     # Construir el mapa final (solo buckets con suficientes muestras)
198:     min_muestras = 15
199:     mapa = {}
200:     for bucket, stats in sorted(buckets.items()):
201:         if stats['total'] >= min_muestras:
202:             prob = stats['up_wins'] / stats['total']
203:             if prob > 0.5:  # Solo incluir rangos con ventaja estadística real
204:                 mapa[bucket] = round(prob, 3)
205:     
206:     return mapa
207: 
208: def ejecutar_analisis(interval="1m", days=30):
209:     """Función principal: descarga datos, analiza y devuelve el mapa de probabilidades."""
210:     candles = descargar_velas_binance(interval=interval, days=days)
211:     windows = agrupar_por_ventana(candles, interval)
212:     mapa = calcular_mapa_probabilidades(windows, interval)
213: 
214:     print(f"⚙️  calib {interval}: {len(candles)} velas · {len(windows)} ventanas · {len(mapa)} rangos con ventaja", flush=True)
215:     
216:     return mapa
217: 
218: 
219: # ---------------------------------------------------------------------------
220: # Análisis TEMPORAL: probabilidad condicionada al tiempo transcurrido.
221: #
222: # El mapa simple responde "dado que la caída MÁXIMA de toda la ventana fue <=X%,
223: # ¿qué % cerró UP?". En vivo eso es sesgo de look-ahead: al inicio de la ventana
224: # la caída acumulada es ~0 pero todavía no sabes cuánto caerá. El mapa temporal
225: # responde la pregunta correcta: "dado que a los E minutos la caída ACUMULADA
226: # hasta ahora es <=X%, ¿qué % cierra UP?".
227: # ---------------------------------------------------------------------------
228: 
229: # (sub_intervalo, paso_min, checkpoints_en_minutos, minutos_ventana)
230: _SUB_CONFIG = {
231:     "5m":  ("1m", 1, list(range(1, 5)),  5),
232:     "15m": ("1m", 1, list(range(1, 15)), 15),
233:     "1h":  ("5m", 5, list(range(5, 60, 5)), 60),
234: }
235: 
236: 
237: def _drop_bucket(interval, caida_pct):
238:     if interval in ("1m", "5m"):
239:         if caida_pct <= 0.05: return 0.0005
240:         if caida_pct <= 0.10: return 0.001
241:         if caida_pct <= 0.15: return 0.0015
242:         if caida_pct <= 0.20: return 0.002
243:         if caida_pct <= 0.30: return 0.003
244:         return None
245:     if interval in ("15m", "30m"):
246:         if caida_pct <= 0.1: return 0.001
247:         if caida_pct <= 0.2: return 0.002
248:         if caida_pct <= 0.3: return 0.003
249:         if caida_pct <= 0.5: return 0.005
250:         if caida_pct <= 1.0: return 0.01
251:         return None
252:     if interval == "1h":
253:         if caida_pct <= 0.1: return 0.001
254:         if caida_pct <= 0.2: return 0.002
255:         if caida_pct <= 0.5: return 0.005
256:         if caida_pct <= 1.0: return 0.01
257:         return None
258:     return None
259: 
260: 
261: def ejecutar_analisis_temporal(interval="5m", days=30, source="binance"):
262:     """Descarga sub-velas finas y construye la tabla de probabilidad condicionada al tiempo.
263: 
264:     `source` selecciona la fuente de precio: "binance" (BTC/USDT, para el bot de 1h) o
265:     "coinbase" (BTC/USD, para 5m/15m, que es el par que usa la resolución por Chainlink).
266: 
267:     Devuelve {elapsed_min: {drop_limit: prob}} solo con buckets que tengan muestras
268:     suficientes y ventaja estadística real (prob > 0.5).
269:     """
270:     sub_intervalo, paso, checkpoints, win_min = _SUB_CONFIG[interval]
271:     window_ms = win_min * 60000
272:     sub_ms = paso * 60000
273: 
274:     candles = descargar_velas(interval=sub_intervalo, days=days, source=source)
275: 
276:     # Agrupar sub-velas por ventana padre, en orden temporal.
277:     ventanas = defaultdict(list)
278:     for c in candles:
279:         open_time = c[0]
280:         wk = (open_time // window_ms) * window_ms
281:         ventanas[wk].append((open_time, float(c[1]), float(c[3]), float(c[4])))  # t, open, low, close
282: 
283:     # buckets[(elapsed, drop_limit)] = {'total':, 'up_wins':}
284:     buckets = defaultdict(lambda: {"total": 0, "up_wins": 0})
285:     completas = 0
286: 
287:     for wk, subs in ventanas.items():
288:         subs.sort(key=lambda x: x[0])
289:         n_esperadas = window_ms // sub_ms
290:         if len(subs) < n_esperadas:
291:             continue  # ventana incompleta
292:         completas += 1
293:         open_p = subs[0][1]
294:         close_p = subs[-1][3]
295:         if open_p == 0:
296:             continue
297:         cierre_up = close_p >= open_p
298: 
299:         running_low = open_p
300:         for i, (_, _, low_p, _) in enumerate(subs):
301:             if low_p < running_low:
302:                 running_low = low_p
303:             elapsed = (i + 1) * paso  # minutos transcurridos al cerrar esta sub-vela
304:             if elapsed not in checkpoints:
305:                 continue
306:             caida_pct = (open_p - running_low) / open_p * 100
307:             bucket = _drop_bucket(interval, caida_pct)
308:             if bucket is None:
309:                 continue
310:             key = (elapsed, bucket)
311:             buckets[key]["total"] += 1
312:             if cierre_up:
313:                 buckets[key]["up_wins"] += 1
314: 
315:     min_muestras = 15
316:     tabla = {}
317:     for (elapsed, bucket), stats in buckets.items():
318:         if stats["total"] >= min_muestras:
319:             prob = stats["up_wins"] / stats["total"]
320:             if prob > 0.5:
321:                 tabla.setdefault(elapsed, {})[bucket] = round(prob, 3)
322: 
323:     n_rangos = sum(len(v) for v in tabla.values())
324:     print(f"⚙️  calib {interval}: {len(candles)} sub-velas · {completas} ventanas · "
325:           f"{len(tabla)} checkpoints · {n_rangos} rangos con ventaja", flush=True)
326:     return tabla
327: 
328: 
329: def probabilidad_temporal(tabla, interval, elapsed_min, caida_pct):
330:     """Busca P(UP) condicionada a (minutos transcurridos, caída acumulada).
331: 
332:     Ajusta `elapsed_min` a la rejilla de checkpoints del timeframe. Si todavía no
333:     se alcanza el primer checkpoint o no hay bucket con ventaja, devuelve 0.0.
334:     """
335:     if not tabla:
336:         return 0.0
337:     _, paso, checkpoints, _ = _SUB_CONFIG[interval]
338:     cp = (int(elapsed_min) // paso) * paso
339:     if cp < checkpoints[0]:
340:         return 0.0
341:     if cp > checkpoints[-1]:
342:         cp = checkpoints[-1]
343:     fila = tabla.get(cp)
344:     if not fila:
345:         return 0.0
346:     caida = round(caida_pct, 6)
347:     for limite, prob in sorted(fila.items()):
348:         if caida <= limite * 100:
349:             return prob
350:     return 0.0
351: 
352: 
353: if __name__ == "__main__":
354:     print("=" * 60)
355:     print("PRUEBA DEL MÓDULO DE ANÁLISIS TEMPORAL")
356:     print("=" * 60)
357:     for interval in ["5m", "15m", "1h"]:
358:         print(f"\n--- {interval} ---")
359:         tabla = ejecutar_analisis_temporal(interval=interval, days=30)
360:         for cp in sorted(tabla):
361:             print(f"  +{cp}min -> {tabla[cp]}")
