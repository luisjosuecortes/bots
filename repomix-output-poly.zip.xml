244: async def simular_fill_clob(session, token_id, tamano_orden):
245:     """Simula el fill REAL de una orden de mercado de COMPRA de 'tamano_orden' unidades
246:     de UP, caminando el order book del CLOB nivel a nivel (de menor a mayor precio).
247: 
248:     Devuelve (precio_promedio, tamano_llenado, llenado_completo, niveles, mejor_ask):
249:       - precio_promedio : VWAP de ejecución (lo que pagarías de media por unidad).
250:       - tamano_llenado  : cuántas unidades se pudieron llenar (≤ tamano_orden).
251:       - llenado_completo: True si se llenó toda la orden.
252:       - niveles         : cuántos niveles del libro tuvo que barrer.
253:       - mejor_ask       : precio del primer nivel (referencia/punto de partida).
254: 
255:     Esto modela el slippage real: una orden grande "come" varios niveles y paga un
256:     precio promedio peor que el mejor ask. Todo es de SOLO LECTURA (gratis).
257:     """
258:     if not token_id or tamano_orden <= 0:
259:         return 0.0, 0.0, False, 0, 0.0
260:     try:
261:         url = f"https://clob.polymarket.com/book?token_id={token_id}"
262:         async with session.get(url) as resp:
263:             book = await resp.json()
264:         asks = book.get("asks") or []
265:         if not asks:
266:             return 0.0, 0.0, False, 0, 0.0
267: 
268:         niveles_ord = sorted(
269:             ((float(a["price"]), float(a.get("size", 0.0))) for a in asks),
270:             key=lambda x: x[0],
271:         )
272:         mejor_ask = niveles_ord[0][0]
273: 
274:         restante = float(tamano_orden)
275:         costo = 0.0
276:         llenado = 0.0
277:         niveles_usados = 0
278:         for precio, size in niveles_ord:
279:             if restante <= 0:
280:                 break
281:             toma = min(restante, size)
282:             costo += toma * precio
283:             llenado += toma
284:             restante -= toma
285:             niveles_usados += 1
286: 
287:         if llenado <= 0:
288:             return 0.0, 0.0, False, 0, mejor_ask
289:         precio_promedio = costo / llenado
290:         llenado_completo = restante <= 1e-9
291:         return precio_promedio, llenado, llenado_completo, niveles_usados, mejor_ask
292:     except Exception:
293:         return 0.0, 0.0, False, 0, 0.0
