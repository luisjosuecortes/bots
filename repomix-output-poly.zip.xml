126: async def _coinbase_klines(session, interval, limit=None, start_dt=None, end_dt=None):
127:     """Velas de Coinbase (BTC-USD) normalizadas a [t_ms, open, high, low, close], ascendente."""
128:     gran = _GRAN_COINBASE.get(interval, 60)
129:     url = f"https://api.exchange.coinbase.com/products/BTC-USD/candles?granularity={gran}"
130:     if start_dt is not None:
131:         end_dt = end_dt or datetime.now(timezone.utc)
132:         url += f"&start={start_dt.isoformat()}&end={end_dt.isoformat()}"
133:     async with session.get(url) as resp:
134:         data = await resp.json()
135:     # Coinbase: [time_s, low, high, open, close, volume], más reciente primero.
136:     norm = [[c[0] * 1000, c[3], c[2], c[1], c[4]] for c in data]
137:     norm.sort(key=lambda x: x[0])
138:     if limit and not start_dt:
139:         norm = norm[-int(limit):]
140:     return norm
